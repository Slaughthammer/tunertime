<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    >
    <FrameLayout android:id="@+id/surface_frame"
	android:layout_width="fill_parent"
	android:layout_height="1dp"
	android:layout_weight="5">
	<SurfaceView android:id="@+id/strobe"
	    android:layout_width="fill_parent"
	    android:layout_height="fill_parent" />
    </FrameLayout>
    <LinearLayout
	android:layout_width="fill_parent"
	android:layout_height="1dp"
	android:layout_weight="2"
	android:orientation="horizontal">
	<FrameLayout android:id="@+id/buttons_holder"
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="3" />
	<LinearLayout
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="1"
	    android:orientation="vertical">
	    <TextView android:id="@+id/center_display"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:gravity="right"
		android:lines="1"
		android:singleLine="true"
		android:textAppearance="?android:attr/textAppearanceMedium" 
		android:textColor="#66F" />
	    <TextView android:id="@+id/stretch_display"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:gravity="right"
		android:lines="1"
		android:singleLine="true"
		android:textAppearance="?android:attr/textAppearanceMedium" 
		android:textColor="#66F" />
	    <FrameLayout android:id="@+id/mode_holder"
		android:layout_width="fill_parent"
		android:layout_height="1dp"
		android:layout_weight="1" />
	</LinearLayout>
    </LinearLayout>
</LinearLayout>
