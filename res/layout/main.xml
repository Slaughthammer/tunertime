<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    >
    <SurfaceView android:id="@+id/strobe"
	android:layout_width="fill_parent"
	android:layout_height="1dp"
	android:layout_weight="5" />
    <LinearLayout android:id="@+id/main_buttons"
	android:layout_width="fill_parent"
	android:layout_height="1dp"
	android:layout_weight="2"
	android:orientation="horizontal">
	<LinearLayout
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="1"
	    android:orientation="vertical">
            <Button
	        android:layout_width="fill_parent"
		android:layout_height="1dp"
		android:layout_weight="1"
		android:text="semi+"
		android:textAppearance="?android:attr/textAppearanceMedium"
		android:onClick="semi_incr" />
	    <TextView android:id="@+id/semi_display"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:gravity="center"
		android:lines="1"
		android:singleLine="true"
		android:textAppearance="?android:attr/textAppearanceLarge" 
		android:textColor="#fc4" />
            <Button
	        android:layout_width="fill_parent"
		android:layout_height="1dp"
		android:layout_weight="1"
		android:text="semi-"
		android:textAppearance="?android:attr/textAppearanceMedium"
		android:onClick="semi_decr" />
	</LinearLayout>
	<LinearLayout
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="1"
	    android:orientation="vertical">
            <Button
	        android:layout_width="fill_parent"
		android:layout_height="1dp"
		android:layout_weight="1"
		android:text="oct+"
		android:textAppearance="?android:attr/textAppearanceMedium"
		android:onClick="oct_incr" />
	    <TextView android:id="@+id/oct_display"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:gravity="center"
		android:lines="1"
		android:singleLine="true"
		android:textAppearance="?android:attr/textAppearanceLarge" 
		android:textColor="#fc4" />
            <Button
	        android:layout_width="fill_parent"
		android:layout_height="1dp"
		android:layout_weight="1"
		android:text="oct-"
		android:textAppearance="?android:attr/textAppearanceMedium"
		android:onClick="oct_decr" />
	</LinearLayout>
	<LinearLayout
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="1"
	    android:orientation="vertical">
            <Button
	        android:layout_width="fill_parent"
		android:layout_height="1dp"
		android:layout_weight="1"
		android:text="cent+"
		android:textAppearance="?android:attr/textAppearanceMedium"
		android:onClick="cent_incr" />
	    <TextView android:id="@+id/cent_display"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:gravity="center"
		android:lines="1"
		android:singleLine="true"
		android:textAppearance="?android:attr/textAppearanceLarge" 
		android:textColor="#fc4" />
            <Button
	        android:layout_width="fill_parent"
		android:layout_height="1dp"
		android:layout_weight="1"
		android:text="cent-"
		android:textAppearance="?android:attr/textAppearanceMedium"
		android:onClick="cent_decr" />
	</LinearLayout>
	<LinearLayout
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="1"
	    android:orientation="vertical">
	    <TextView android:id="@+id/center_display"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:gravity="right"
		android:lines="1"
		android:singleLine="true"
		android:textAppearance="?android:attr/textAppearanceMedium" 
		android:textColor="#66F" />
	    <TextView android:id="@+id/stretch_display"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:gravity="right"
		android:lines="1"
		android:singleLine="true"
		android:textAppearance="?android:attr/textAppearanceMedium" 
		android:textColor="#66F" />
            <Button
	        android:layout_width="fill_parent"
		android:layout_height="1dp"
		android:layout_weight="1"
		android:text="conf"
		android:textColor="#060"
		android:textAppearance="?android:attr/textAppearanceMedium"
		android:onClick="do_conf" />
	</LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/conf_buttons"
	android:layout_width="fill_parent"
	android:layout_height="1dp"
	android:layout_weight="2"
	android:orientation="horizontal">
	<LinearLayout
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="1"
	    android:orientation="vertical">
            <Button
	        android:layout_width="fill_parent"
		android:layout_height="1dp"
		android:layout_weight="1"
		android:text="A+"
		android:textAppearance="?android:attr/textAppearanceMedium"
		android:onClick="A_incr" />
	    <TextView android:id="@+id/center_display2"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:gravity="center"
		android:lines="1"
		android:singleLine="true"
		android:textAppearance="?android:attr/textAppearanceLarge" 
		android:textColor="#66F" />
            <Button
	        android:layout_width="fill_parent"
		android:layout_height="1dp"
		android:layout_weight="1"
		android:text="A-"
		android:textAppearance="?android:attr/textAppearanceMedium"
		android:onClick="A_decr" />
	</LinearLayout>
	<LinearLayout
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="1"
	    android:orientation="vertical">
            <Button
	        android:layout_width="fill_parent"
		android:layout_height="1dp"
		android:layout_weight="1"
		android:text="stretch+"
		android:textAppearance="?android:attr/textAppearanceMedium"
		android:onClick="stretch_incr" />
	    <TextView android:id="@+id/stretch_display2"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:gravity="center"
		android:lines="1"
		android:singleLine="true"
		android:textAppearance="?android:attr/textAppearanceLarge" 
		android:textColor="#66F" />
            <Button
	        android:layout_width="fill_parent"
		android:layout_height="1dp"
		android:layout_weight="1"
		android:text="stretch-"
		android:textAppearance="?android:attr/textAppearanceMedium"
		android:onClick="stretch_decr" />
	</LinearLayout>
	<LinearLayout
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="1"
	    android:orientation="vertical">
            <Button
	        android:layout_width="fill_parent"
		android:layout_height="1dp"
		android:layout_weight="1"
		android:text="reset"
		android:textAppearance="?android:attr/textAppearanceMedium"
		android:textColor="#800"
		android:onClick="reset_conf" />
            <Button
	        android:layout_width="fill_parent"
		android:layout_height="1dp"
		android:layout_weight="1"
		android:text="note"
		android:textColor="#060"
		android:textAppearance="?android:attr/textAppearanceMedium"
		android:onClick="do_note" />
	</LinearLayout>
    </LinearLayout>
</LinearLayout>
