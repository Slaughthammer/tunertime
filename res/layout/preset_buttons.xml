<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">
    <LinearLayout
	android:layout_width="1dp"
	android:layout_height="fill_parent"
	android:layout_weight="3"
	android:orientation="vertical">
	<Button
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:text="note+"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="preset_incr" />
	<TextView android:id="@+id/preset_semi_display"
	    android:layout_width="fill_parent"
	    android:layout_height="wrap_content"
	    android:gravity="center"
	    android:lines="1"
	    android:singleLine="true"
	    android:textAppearance="?android:attr/textAppearanceLarge" 
	    android:textColor="#fc4" />
	<Button
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:text="note-"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="preset_decr" />
    </LinearLayout>
    <LinearLayout
	android:layout_width="1dp"
	android:layout_height="fill_parent"
	android:layout_weight="2"
	android:orientation="vertical">
	<Button
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:text="oct+"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="preset_oct_incr" />
	<TextView android:id="@+id/preset_oct_display"
	    android:layout_width="fill_parent"
	    android:layout_height="wrap_content"
	    android:gravity="center"
	    android:lines="1"
	    android:singleLine="true"
	    android:textAppearance="?android:attr/textAppearanceLarge" 
	    android:textColor="#fc4" />
	<Button
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:text="oct-"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="preset_oct_decr" />
    </LinearLayout>
    <LinearLayout
	android:layout_width="1dp"
	android:layout_height="fill_parent"
	android:layout_weight="2"
	android:orientation="vertical">
	<Button android:id="@+id/preset_select"
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:text="select"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="do_preset_select" />
	<Button android:id="@+id/preset_edit"
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:text="edit"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="do_preset_edit" />
    </LinearLayout>
</LinearLayout>
