<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">
    <LinearLayout
	android:layout_width="1dp"
	android:layout_height="fill_parent"
	android:layout_weight="1"
	android:orientation="vertical">
	<Button
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:text="N+"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="N_incr" />
	<TextView android:id="@+id/N_display"
	    android:layout_width="fill_parent"
	    android:layout_height="wrap_content"
	    android:gravity="center"
	    android:lines="1"
	    android:singleLine="true"
	    android:textAppearance="?android:attr/textAppearanceLarge" 
	    android:textColor="#fc4" />
	<Button
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:text="N-"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="N_decr" />
    </LinearLayout>
    <LinearLayout
	android:layout_width="1dp"
	android:layout_height="fill_parent"
	android:layout_weight="1"
	android:orientation="vertical">
	<Button android:id="@+id/grid_button"
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:text="scale"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="grid_toggle" />
	<Button android:id="@+id/window_button"
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:text="bartlett"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="window_toggle" />
    </LinearLayout>
</LinearLayout>
