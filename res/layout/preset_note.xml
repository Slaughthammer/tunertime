<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">
    <TextView android:id="@+id/pn_text"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content"
	android:layout_gravity="center_horizontal"
	android:textAppearance="?android:attr/textAppearanceLarge"
	android:textSize="35sp" />
    <LinearLayout
	android:orientation="horizontal"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content">
	<Button
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:layout_height="wrap_content"
	    android:text="C"
	    android:textAppearance="?android:attr/textAppearanceLarge"
	    android:onClick="do_note_C" />
	<Button
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:layout_height="wrap_content"
	    android:text="D"
	    android:textAppearance="?android:attr/textAppearanceLarge"
	    android:onClick="do_note_D" />
	<Button
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:layout_height="wrap_content"
	    android:text="E"
	    android:textAppearance="?android:attr/textAppearanceLarge"
	    android:onClick="do_note_E" />
	<Button
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:layout_height="wrap_content"
	    android:text="F"
	    android:textAppearance="?android:attr/textAppearanceLarge"
	    android:onClick="do_note_F" />
	<Button
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:layout_height="wrap_content"
	    android:text="G"
	    android:textAppearance="?android:attr/textAppearanceLarge"
	    android:onClick="do_note_G" />
	<Button
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:layout_height="wrap_content"
	    android:text="A"
	    android:textAppearance="?android:attr/textAppearanceLarge"
	    android:onClick="do_note_A" />
	<Button
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:layout_height="wrap_content"
	    android:text="B"
	    android:textAppearance="?android:attr/textAppearanceLarge"
	    android:onClick="do_note_B" />
    </LinearLayout>
    <LinearLayout
	android:orientation="horizontal"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content">
	<View
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:layout_height="1dp" />
	<Button
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:layout_height="wrap_content"
	    android:layout_gravity="center_horizontal"
	    android:text="#"
	    android:textAppearance="?android:attr/textAppearanceLarge"
	    android:onClick="do_sharp" />
	<View
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:layout_height="1dp" />
    </LinearLayout>
    <LinearLayout
	android:orientation="horizontal"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content">
	<Button
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:layout_height="wrap_content"
	    android:text="0"
	    android:textAppearance="?android:attr/textAppearanceLarge"
	    android:onClick="do_oct_0" />
	<Button
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:layout_height="wrap_content"
	    android:text="1"
	    android:textAppearance="?android:attr/textAppearanceLarge"
	    android:onClick="do_oct_1" />
	<Button
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:layout_height="wrap_content"
	    android:text="2"
	    android:textAppearance="?android:attr/textAppearanceLarge"
	    android:onClick="do_oct_2" />
	<Button
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:layout_height="wrap_content"
	    android:text="3"
	    android:textAppearance="?android:attr/textAppearanceLarge"
	    android:onClick="do_oct_3" />
	<Button
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:layout_height="wrap_content"
	    android:text="4"
	    android:textAppearance="?android:attr/textAppearanceLarge"
	    android:onClick="do_oct_4" />
	<Button
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:layout_height="wrap_content"
	    android:text="5"
	    android:textAppearance="?android:attr/textAppearanceLarge"
	    android:onClick="do_oct_5" />
	<Button
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:layout_height="wrap_content"
	    android:text="6"
	    android:textAppearance="?android:attr/textAppearanceLarge"
	    android:onClick="do_oct_6" />
	<Button
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:layout_height="wrap_content"
	    android:text="7"
	    android:textAppearance="?android:attr/textAppearanceLarge"
	    android:onClick="do_oct_7" />
	<Button
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:layout_height="wrap_content"
	    android:text="8"
	    android:textAppearance="?android:attr/textAppearanceLarge"
	    android:onClick="do_oct_8" />
    </LinearLayout>
    <LinearLayout
	android:orientation="horizontal"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content">
	<TextView
	    android:layout_width="wrap_content"
	    android:layout_height="wrap_content"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:text="cents:" />
	<EditText android:id="@+id/pn_cents"
	    android:layout_width="wrap_content"
	    android:layout_height="wrap_content"
	    android:textAppearance="?android:attr/textAppearanceLarge"
	    android:minEms="3"
	    android:lines="1"
	    android:singleLine="true"
	    android:numeric="signed" />
    </LinearLayout>
    <LinearLayout
	android:orientation="horizontal"
	android:layout_width="fill_parent"
	android:layout_height="1dp"
	android:layout_weight="1">
	<Button
	    android:layout_width="1dp"
	    android:layout_height="wrap_content"
	    android:layout_weight="1"
	    android:layout_gravity="bottom"
	    android:text="delete"
	    android:textAppearance="?android:attr/textAppearanceLarge"
	    android:onClick="do_delete" />
	<Button
	    android:layout_width="1dp"
	    android:layout_height="wrap_content"
	    android:layout_weight="1"
	    android:layout_gravity="bottom"
	    android:text="save"
	    android:textAppearance="?android:attr/textAppearanceLarge"
	    android:onClick="do_save" />
    </LinearLayout>
</LinearLayout>
