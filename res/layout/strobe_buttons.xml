<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_gravity="bottom"
    android:layout_height="wrap_content">
    <Button android:id="@+id/note_button"
	    android:layout_width="1dp"
	    android:layout_height="wrap_content"
	    android:layout_weight="1"
	    android:text="Note"
	    android:textAppearance="?android:attr/textAppearanceSmall"
	    android:singleLine="true"
	    android:onClick="note_clicked" />
    <Button android:id="@+id/afreq_button"
	    android:layout_width="1dp"
	    android:layout_height="wrap_content"
	    android:layout_weight="1"
	    android:text="A freq"
	    android:textAppearance="?android:attr/textAppearanceSmall"
	    android:singleLine="true"
	    android:onClick="afreq_clicked" />
    <Button android:id="@+id/stretch_button"
	    android:layout_width="1dp"
	    android:layout_height="wrap_content"
	    android:layout_weight="1"
	    android:text="Stretch"
	    android:textAppearance="?android:attr/textAppearanceSmall"
	    android:singleLine="true"
	    android:onClick="stretch_clicked" />
    <Button android:id="@+id/temper_button"
	    android:layout_width="1dp"
	    android:layout_height="wrap_content"
	    android:layout_weight="1"
	    android:text="Temper"
	    android:textAppearance="?android:attr/textAppearanceSmall"
	    android:singleLine="true"
	    android:onClick="temper_clicked" />
    <Button android:id="@+id/harm_button"
	    android:layout_width="1dp"
	    android:layout_height="wrap_content"
	    android:layout_weight="1"
	    android:text="Harmonics"
	    android:textAppearance="?android:attr/textAppearanceSmall"
	    android:singleLine="true"
	    android:onClick="harm_clicked" />
</LinearLayout>
