<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">
    <LinearLayout
	android:layout_width="1dp"
	android:layout_height="fill_parent"
	android:layout_weight="1"
	android:orientation="vertical">
	<Button
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:text="semi+"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="semi_incr" />
	<TextView android:id="@+id/semi_display2"
	    android:layout_width="fill_parent"
	    android:layout_height="wrap_content"
	    android:gravity="center"
	    android:lines="1"
	    android:singleLine="true"
	    android:textAppearance="?android:attr/textAppearanceLarge" 
	    android:textColor="#fc4" />
	<Button
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:text="semi-"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="semi_decr" />
    </LinearLayout>
    <LinearLayout
	android:layout_width="1dp"
	android:layout_height="fill_parent"
	android:layout_weight="1"
	android:orientation="vertical">
	<Button
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:text="cent+"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="cent_incr" />
	<TextView android:id="@+id/cent_display2"
	    android:layout_width="fill_parent"
	    android:layout_height="wrap_content"
	    android:gravity="center"
	    android:lines="1"
	    android:singleLine="true"
	    android:textAppearance="?android:attr/textAppearanceLarge" 
	    android:textColor="#fc4" />
	<Button
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:text="cent-"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="cent_decr" />
    </LinearLayout>
    <LinearLayout
	android:layout_width="1dp"
	android:layout_height="fill_parent"
	android:layout_weight="1"
	android:orientation="vertical">
	<Button android:id="@+id/temper_save"
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:text="save"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="do_temper_save" />
	<Button android:id="@+id/temper_enable"
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:text="enable"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="do_temper_enable" />
    </LinearLayout>
</LinearLayout>
