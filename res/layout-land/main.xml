<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_height="fill_parent"
    android:layout_width="fill_parent"
    >
    <SurfaceView android:id="@+id/strobe"
	android:layout_height="fill_parent"
	android:layout_width="1dp"
	android:layout_weight="5" />
    <LinearLayout android:id="@+id/main_buttons"
	android:layout_height="fill_parent"
	android:layout_width="1dp"
	android:layout_weight="2"
	android:orientation="vertical">
	<LinearLayout
	    android:layout_height="1dp"
	    android:layout_width="fill_parent"
	    android:layout_weight="1"
	    android:orientation="horizontal">
            <Button
	        android:layout_height="fill_parent"
		android:layout_width="1dp"
		android:layout_weight="1"
		android:text="-"
		android:textAppearance="?android:attr/textAppearanceSmall"
		android:onClick="semi_decr" />
	    <TextView android:id="@+id/semi_display"
		android:layout_height="fill_parent"
		android:layout_width="wrap_content"
		android:gravity="center"
		android:lines="1"
		android:minWidth="40dp"
		android:singleLine="true"
		android:textAppearance="?android:attr/textAppearanceMedium" 
		android:textColor="#fc4" />
            <Button
	        android:layout_height="fill_parent"
		android:layout_width="1dp"
		android:layout_weight="1"
		android:text="+"
		android:textAppearance="?android:attr/textAppearanceSmall"
		android:onClick="semi_incr" />
	</LinearLayout>
	<LinearLayout
	    android:layout_height="1dp"
	    android:layout_width="fill_parent"
	    android:layout_weight="1"
	    android:orientation="horizontal">
            <Button
	        android:layout_height="fill_parent"
		android:layout_width="1dp"
		android:layout_weight="1"
		android:text="O-"
		android:textAppearance="?android:attr/textAppearanceSmall"
		android:onClick="oct_decr" />
	    <TextView android:id="@+id/oct_display"
		android:layout_height="fill_parent"
		android:layout_width="wrap_content"
		android:gravity="center"
		android:lines="1"
		android:minWidth="40dp"
		android:singleLine="true"
		android:textAppearance="?android:attr/textAppearanceMedium" 
		android:textColor="#fc4" />
            <Button
	        android:layout_height="fill_parent"
		android:layout_width="1dp"
		android:layout_weight="1"
		android:text="O+"
		android:textAppearance="?android:attr/textAppearanceSmall"
		android:onClick="oct_incr" />
	</LinearLayout>
	<LinearLayout
	    android:layout_height="1dp"
	    android:layout_width="fill_parent"
	    android:layout_weight="1"
	    android:orientation="horizontal">
            <Button
	        android:layout_height="fill_parent"
		android:layout_width="1dp"
		android:layout_weight="1"
		android:text="c-"
		android:textAppearance="?android:attr/textAppearanceSmall"
		android:onClick="cent_decr" />
	    <TextView android:id="@+id/cent_display"
		android:layout_height="fill_parent"
		android:layout_width="wrap_content"
		android:gravity="center"
		android:lines="1"
		android:minWidth="40dp"
		android:singleLine="true"
		android:textAppearance="?android:attr/textAppearanceMedium" 
		android:textColor="#fc4" />
            <Button
	        android:layout_height="fill_parent"
		android:layout_width="1dp"
		android:layout_weight="1"
		android:text="c+"
		android:textAppearance="?android:attr/textAppearanceSmall"
		android:onClick="cent_incr" />
	</LinearLayout>
	<LinearLayout
	    android:layout_height="1dp"
	    android:layout_width="fill_parent"
	    android:layout_weight="1"
	    android:orientation="horizontal">
	    <LinearLayout
		android:layout_height="fill_parent"
		android:layout_width="wrap_content"
		android:orientation="vertical">
		<TextView android:id="@+id/center_display"
		    android:layout_height="wrap_content"
		    android:layout_width="wrap_content"
		    android:layout_weight="1"
		    android:gravity="left|bottom"
		    android:lines="1"
		    android:singleLine="true"
		    android:textAppearance="?android:attr/textAppearanceMedium" 
		    android:textColor="#66F" />
		<TextView android:id="@+id/stretch_display"
		    android:layout_height="wrap_content"
		    android:layout_width="wrap_content"
		    android:gravity="left"
		    android:lines="1"
		    android:singleLine="true"
		    android:textAppearance="?android:attr/textAppearanceMedium" 
		    android:textColor="#66F" />
	    </LinearLayout>
            <Button
	        android:layout_height="fill_parent"
		android:layout_width="1dp"
		android:layout_weight="1"
		android:text="conf"
		android:textColor="#060"
		android:textAppearance="?android:attr/textAppearanceMedium"
		android:onClick="do_conf" />
	</LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/conf_buttons"
	android:layout_height="fill_parent"
	android:layout_width="1dp"
	android:layout_weight="2"
	android:orientation="vertical">
	<Button
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:text="A+"
	    android:textAppearance="?android:attr/textAppearanceSmall"
	    android:onClick="A_incr" />
	<TextView android:id="@+id/center_display2"
	    android:layout_width="fill_parent"
	    android:layout_height="wrap_content"
	    android:gravity="center"
	    android:lines="1"
	    android:singleLine="true"
	    android:textAppearance="?android:attr/textAppearanceMedium" 
	    android:textColor="#66F" />
	<Button
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:text="A-"
	    android:textAppearance="?android:attr/textAppearanceSmall"
	    android:onClick="A_decr" />
	<Button
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:text="stretch+"
	    android:textAppearance="?android:attr/textAppearanceSmall"
	    android:onClick="stretch_incr" />
	<TextView android:id="@+id/stretch_display2"
	    android:layout_width="fill_parent"
	    android:layout_height="wrap_content"
	    android:gravity="center"
	    android:lines="1"
	    android:singleLine="true"
	    android:textAppearance="?android:attr/textAppearanceMedium" 
	    android:textColor="#66F" />
	<Button
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:text="stretch-"
	    android:textAppearance="?android:attr/textAppearanceSmall"
	    android:onClick="stretch_decr" />
	<LinearLayout
	    android:layout_height="1dp"
	    android:layout_width="fill_parent"
	    android:layout_weight="2"
	    android:orientation="horizontal">
            <Button
	        android:layout_height="fill_parent"
		android:layout_width="1dp"
		android:layout_weight="1"
		android:text="reset"
		android:textAppearance="?android:attr/textAppearanceMedium"
		android:textColor="#800"
		android:onClick="reset_conf" />
            <Button
	        android:layout_height="fill_parent"
		android:layout_width="1dp"
		android:layout_weight="1"
		android:text="note"
		android:textColor="#060"
		android:textAppearance="?android:attr/textAppearanceMedium"
		android:onClick="do_note" />
	</LinearLayout>
    </LinearLayout>
</LinearLayout>
