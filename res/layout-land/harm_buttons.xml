<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_height="fill_parent"
    android:layout_width="fill_parent">
    <LinearLayout
	android:layout_height="1dp"
	android:layout_width="fill_parent"
	android:layout_weight="1"
	android:orientation="horizontal">
	<Button
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:text="harm1+"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="harm1_incr" />
	<TextView android:id="@+id/harm1_display"
	    android:layout_height="fill_parent"
	    android:layout_width="wrap_content"
	    android:gravity="center"
	    android:lines="1"
	    android:singleLine="true"
	    android:textAppearance="?android:attr/textAppearanceLarge" 
	    android:textColor="#fc4" />
	<Button
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:text="harm1-"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="harm1_decr" />
    </LinearLayout>
    <LinearLayout
	android:layout_height="1dp"
	android:layout_width="fill_parent"
	android:layout_weight="1"
	android:orientation="horizontal">
	<Button
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:text="harm2+"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="harm2_incr" />
	<TextView android:id="@+id/harm2_display"
	    android:layout_height="fill_parent"
	    android:layout_width="wrap_content"
	    android:gravity="center"
	    android:lines="1"
	    android:singleLine="true"
	    android:textAppearance="?android:attr/textAppearanceLarge" 
	    android:textColor="#fc4" />
	<Button
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:text="harm2-"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="harm2_decr" />
    </LinearLayout>
    <Button
	android:layout_height="1dp"
	android:layout_width="fill_parent"
	android:layout_weight="1"
	android:text="reset"
	android:textAppearance="?android:attr/textAppearanceMedium"
	android:onClick="reset_harm" />
</LinearLayout>
