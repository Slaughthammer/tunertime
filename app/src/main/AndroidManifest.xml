<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application android:label="${appLabel}" android:icon="@drawable/icon"
		android:theme="@style/Tuner"
		android:localeConfig="@xml/locales_config">
        <activity android:name="TunerTime" android:label="${appLabel}"
		android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="Settings"
		android:label="@string/title_settings" />
	<activity android:name="PresetSelectActivity"
		android:label="@string/title_preset_select" />
	<activity android:name="PresetEditActivity"
		android:label="@string/title_preset_edit" />
	<activity android:name="PresetNoteActivity"
		android:label="@string/title_preset_note" />
    </application>
</manifest>
