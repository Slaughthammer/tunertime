<?xml version="1.0" encoding="utf-8"?>
<resources>
	<!-- neutral dark theme with one blue accent -->
	<style name="Tuner" parent="@android:style/Theme.Material">
		<item name="android:colorBackground">@color/bg</item>
		<item name="android:windowBackground">@color/bg</item>
		<item name="android:colorPrimary">@color/surface</item>
		<item name="android:colorPrimaryDark">@color/bg</item>
		<item name="android:colorAccent">@color/accent</item>
		<item name="android:colorControlNormal">@color/text_muted</item>
		<item name="android:textColorPrimary">@color/text</item>
		<item name="android:textColorSecondary">@color/text_muted</item>
		<item name="android:textColorHint">@color/outline</item>
		<item name="android:statusBarColor">@color/bg</item>
		<item name="android:navigationBarColor">@color/bg</item>
		<item name="android:buttonStyle">@style/Tuner.Button</item>
	</style>
	<style name="Tuner.Button" parent="@android:style/Widget.Material.Button">
		<item name="android:textColor">@color/text</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:background">@drawable/mode_button</item>
	</style>
</resources>
