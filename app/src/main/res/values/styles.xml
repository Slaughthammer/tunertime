<?xml version="1.0" encoding="utf-8"?>
<resources>
	<!-- neutral dark theme with one blue accent -->
	<style name="Tuner" parent="@android:style/Theme.Material">
		<item name="android:colorBackground">@color/bg</item>
		<item name="android:windowBackground">@color/bg</item>
		<item name="android:colorPrimary">@color/surface</item>
		<item name="android:colorPrimaryDark">@color/bg</item>
		<item name="android:colorAccent">@color/accent</item>
		<item name="android:colorControlNormal">@color/text_muted</item>
		<item name="android:textColorPrimary">@color/text</item>
		<item name="android:textColorSecondary">@color/text_muted</item>
		<item name="android:textColorHint">@color/text_muted</item>
		<item name="android:statusBarColor">@color/bg</item>
		<item name="android:navigationBarColor">@color/bg</item>
		<item name="android:buttonStyle">@style/Tuner.Button</item>
		<item name="android:editTextStyle">@style/Tuner.EditText</item>
		<item name="android:actionOverflowButtonStyle">@style/Tuner.Overflow</item>
		<item name="android:actionBarStyle">@style/Tuner.ActionBar</item>
	</style>
	<!-- 48dp touch targets: the platform's are 40dp wide (overflow "more
	     options") and 45dp high (a text field at font scale 1.0) -->
	<style name="Tuner.Overflow" parent="@android:style/Widget.Material.ActionButton.Overflow">
		<item name="android:minWidth">48dp</item>
		<item name="android:minHeight">48dp</item>
	</style>
	<style name="Tuner.EditText" parent="@android:style/Widget.Material.EditText">
		<item name="android:minHeight">48dp</item>
	</style>
	<!-- the temperament or preset goes in the subtitle (TunerTime.set_title);
	     smaller than the platform's 16sp so that title and subtitle
	     still fit the bar at font scale 1.3 -->
	<style name="Tuner.ActionBar" parent="@android:style/Widget.Material.ActionBar.Solid">
		<item name="android:subtitleTextStyle">@style/Tuner.ActionBar.Subtitle</item>
	</style>
	<style name="Tuner.ActionBar.Subtitle" parent="@android:style/TextAppearance.Material.Widget.ActionBar.Subtitle">
		<item name="android:textSize">13sp</item>
	</style>
	<style name="Tuner.Button" parent="@android:style/Widget.Material.Button">
		<item name="android:textColor">@color/text</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:background">@drawable/mode_button</item>
	</style>

	<!-- The text styles below shrink their text to fit instead of
	     clipping it (narrow phones, large font scale, longer German
	     words).  Autosizing needs Android 8+; older versions just use the
	     maximum size.  It is turned off by android:singleLine (that
	     scrolls horizontally instead), so these use maxLines. -->

	<!-- buttons in the panels below the strobe -->
	<style name="Tuner.Button.Panel">
		<item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
		<item name="android:maxLines">1</item>
		<item name="android:paddingLeft">4dp</item>
		<item name="android:paddingRight">4dp</item>
		<item name="android:autoSizeTextType">uniform</item>
		<item name="android:autoSizeMinTextSize">10sp</item>
		<item name="android:autoSizeMaxTextSize">18sp</item>
	</style>
	<!-- buttons on the preset screens -->
	<style name="Tuner.Button.Big">
		<item name="android:textAppearance">?android:attr/textAppearanceLarge</item>
		<item name="android:maxLines">1</item>
		<item name="android:paddingLeft">4dp</item>
		<item name="android:paddingRight">4dp</item>
		<item name="android:autoSizeTextType">uniform</item>
		<item name="android:autoSizeMinTextSize">12sp</item>
		<item name="android:autoSizeMaxTextSize">22sp</item>
	</style>
	<!-- the mode tabs below the strobe: selected one is underlined -->
	<style name="Tuner.Button.Tab">
		<item name="android:background">@drawable/tab_button</item>
		<item name="android:textColor">@color/tab_text</item>
		<item name="android:textAppearance">?android:attr/textAppearanceSmall</item>
		<item name="android:textStyle">bold</item>
		<item name="android:maxLines">1</item>
		<item name="android:paddingLeft">2dp</item>
		<item name="android:paddingRight">2dp</item>
		<item name="android:minWidth">0dp</item>
		<item name="android:autoSizeTextType">uniform</item>
		<item name="android:autoSizeMinTextSize">9sp</item>
		<item name="android:autoSizeMaxTextSize">15sp</item>
	</style>

	<!-- values: note, cents, A, stretch, ... -->
	<style name="Tuner.Readout">
		<item name="android:textAppearance">?android:attr/textAppearanceLarge</item>
		<item name="android:textColor">@color/text</item>
		<item name="android:fontFamily">monospace</item>
		<item name="android:textStyle">bold</item>
		<item name="android:gravity">center</item>
		<item name="android:maxLines">1</item>
		<item name="android:autoSizeTextType">uniform</item>
		<item name="android:autoSizeMinTextSize">11sp</item>
		<item name="android:autoSizeMaxTextSize">24sp</item>
	</style>
	<!-- the A and stretch status in the corner -->
	<style name="Tuner.Readout.Status">
		<item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
		<item name="android:textColor">@color/text_muted</item>
		<item name="android:textStyle">normal</item>
		<!-- two of these sit above the auto/tone/mode buttons in portrait:
		     kept low so that those stay 48dp high at font scale 1.3 -->
		<item name="android:includeFontPadding">false</item>
		<item name="android:autoSizeMaxTextSize">16sp</item>
	</style>
	<!-- small captions: units, names of the +/- rows -->
	<style name="Tuner.Caption">
		<item name="android:textAppearance">?android:attr/textAppearanceSmall</item>
		<item name="android:textColor">@color/text_muted</item>
		<item name="android:gravity">center</item>
		<item name="android:maxLines">1</item>
		<item name="android:autoSizeTextType">uniform</item>
		<item name="android:autoSizeMinTextSize">9sp</item>
		<item name="android:autoSizeMaxTextSize">14sp</item>
	</style>
</resources>
