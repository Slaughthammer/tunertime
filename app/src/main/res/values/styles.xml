<?xml version="1.0" encoding="utf-8"?>
<resources>
	<!-- Azure look: blue on black, monospace everywhere -->
	<style name="Azure" parent="@android:style/Theme.Material">
		<item name="android:colorBackground">#000000</item>
		<item name="android:windowBackground">@android:color/black</item>
		<item name="android:colorPrimary">#000e1a</item>
		<item name="android:colorPrimaryDark">#000000</item>
		<item name="android:colorAccent">#008cff</item>
		<item name="android:colorControlNormal">#0058a0</item>
		<item name="android:textColorPrimary">#008cff</item>
		<item name="android:textColorSecondary">#0061b0</item>
		<item name="android:textColorTertiary">#00437a</item>
		<item name="android:textColorHint">#00325a</item>
		<item name="android:statusBarColor">#000000</item>
		<item name="android:navigationBarColor">#000000</item>
		<item name="android:textViewStyle">@style/Azure.TextView</item>
		<item name="android:buttonStyle">@style/Azure.Button</item>
		<item name="android:editTextStyle">@style/Azure.EditText</item>
	</style>
	<style name="Azure.TextView" parent="@android:style/Widget.Material.TextView">
		<item name="android:fontFamily">monospace</item>
	</style>
	<style name="Azure.Button" parent="@android:style/Widget.Material.Button">
		<item name="android:fontFamily">monospace</item>
		<item name="android:textColor">#008cff</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:background">@drawable/mode_button</item>
	</style>
	<style name="Azure.EditText" parent="@android:style/Widget.Material.EditText">
		<item name="android:fontFamily">monospace</item>
	</style>
</resources>
