<?xml version="1.0" encoding="utf-8"?>
<!-- preset mode.  the preset note with octave and offset ("C#4 +03.5c")
     is one display, centred between the note and octave buttons -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">
    <LinearLayout
	android:layout_width="1dp"
	android:layout_height="fill_parent"
	android:layout_weight="5"
	android:orientation="vertical">
	<LinearLayout
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:orientation="horizontal">
	    <Button
		style="@style/Tuner.Button.Panel"
		android:layout_width="1dp"
		android:layout_height="fill_parent"
		android:layout_weight="1"
		android:text="note+"
		android:onClick="preset_incr" />
	    <Button
		style="@style/Tuner.Button.Panel"
		android:layout_width="1dp"
		android:layout_height="fill_parent"
		android:layout_weight="1"
		android:text="oct+"
		android:onClick="preset_oct_incr" />
	</LinearLayout>
	<TextView android:id="@+id/preset_semi_display"
	    style="@style/Tuner.Readout"
	    android:layout_width="fill_parent"
	    android:layout_height="wrap_content" />
	<LinearLayout
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:orientation="horizontal">
	    <Button
		style="@style/Tuner.Button.Panel"
		android:layout_width="1dp"
		android:layout_height="fill_parent"
		android:layout_weight="1"
		android:text="note-"
		android:onClick="preset_decr" />
	    <Button
		style="@style/Tuner.Button.Panel"
		android:layout_width="1dp"
		android:layout_height="fill_parent"
		android:layout_weight="1"
		android:text="oct-"
		android:onClick="preset_oct_decr" />
	</LinearLayout>
    </LinearLayout>
    <LinearLayout
	android:layout_width="1dp"
	android:layout_height="fill_parent"
	android:layout_weight="2"
	android:orientation="vertical">
	<Button android:id="@+id/preset_select"
	    style="@style/Tuner.Button.Panel"
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:text="select"
	    android:onClick="do_preset_select" />
	<Button android:id="@+id/preset_edit"
	    style="@style/Tuner.Button.Panel"
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:text="edit"
	    android:onClick="do_preset_edit" />
    </LinearLayout>
</LinearLayout>
