<?xml version="1.0" encoding="utf-8"?>
<!-- mode tabs below the strobe; TunerTime.set_mode() selects one -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_gravity="bottom"
    android:layout_height="wrap_content">
    <Button android:id="@+id/note_button"
	    style="@style/Tuner.Button.Tab"
	    android:layout_width="1dp"
	    android:layout_height="wrap_content"
	    android:layout_weight="1"
	    android:text="note"
	    android:onClick="note_clicked" />
    <Button android:id="@+id/afreq_button"
	    style="@style/Tuner.Button.Tab"
	    android:layout_width="1dp"
	    android:layout_height="wrap_content"
	    android:layout_weight="1"
	    android:text="A freq"
	    android:onClick="afreq_clicked" />
    <Button android:id="@+id/stretch_button"
	    style="@style/Tuner.Button.Tab"
	    android:layout_width="1dp"
	    android:layout_height="wrap_content"
	    android:layout_weight="1"
	    android:text="stretch"
	    android:onClick="stretch_clicked" />
    <Button android:id="@+id/preset_button"
	    style="@style/Tuner.Button.Tab"
	    android:layout_width="1dp"
	    android:layout_height="wrap_content"
	    android:layout_weight="1"
	    android:text="preset"
	    android:onClick="preset_clicked" />
</LinearLayout>
