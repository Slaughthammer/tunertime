<?xml version="1.0" encoding="utf-8"?>
<!-- mode tabs below the strobe; TunerTime.set_mode() selects one.
     fill_parent: all as high as the highest, which a long German
     label like "Kammerton" can make 1dp higher than the others -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_gravity="bottom"
    android:layout_height="wrap_content">
    <Button android:id="@+id/note_button"
	    style="@style/Tuner.Button.Tab"
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="1"
	    android:text="@string/tab_note"
	    android:onClick="note_clicked" />
    <Button android:id="@+id/afreq_button"
	    style="@style/Tuner.Button.Tab"
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="1"
	    android:text="@string/tab_afreq"
	    android:onClick="afreq_clicked" />
    <Button android:id="@+id/stretch_button"
	    style="@style/Tuner.Button.Tab"
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="1"
	    android:text="@string/tab_stretch"
	    android:onClick="stretch_clicked" />
    <Button android:id="@+id/preset_button"
	    style="@style/Tuner.Button.Tab"
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="1"
	    android:text="@string/tab_preset"
	    android:onClick="preset_clicked" />
</LinearLayout>
