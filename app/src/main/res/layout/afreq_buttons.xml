<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">
    <LinearLayout
	android:layout_width="1dp"
	android:layout_height="fill_parent"
	android:layout_weight="2"
	android:orientation="vertical">
	<LinearLayout
	    android:orientation="horizontal"
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1">
	    <Button
		android:layout_width="1dp"
		android:layout_height="fill_parent"
		android:layout_weight="1"
		android:text="+0.1"
		android:textAppearance="?android:attr/textAppearanceMedium"
		android:onClick="A_incrp1" />
	    <Button
		android:layout_width="1dp"
		android:layout_height="fill_parent"
		android:layout_weight="1"
		android:text="+1"
		android:textAppearance="?android:attr/textAppearanceMedium"
		android:onClick="A_incr1" />
	</LinearLayout>
	<LinearLayout
	    android:orientation="horizontal"
	    android:layout_width="fill_parent"
	    android:layout_height="wrap_content">
	    <TextView android:id="@+id/center_display2"
		android:layout_width="1dp"
		android:layout_height="wrap_content"
		android:layout_weight="3"
		android:gravity="center"
		android:lines="1"
		android:singleLine="true"
		android:textAppearance="?android:attr/textAppearanceLarge" 
		android:textColor="#008CFF" />
	    <TextView
		android:layout_width="1dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:lines="1"
		android:singleLine="true"
		android:text="Hz"
		android:textAppearance="?android:attr/textAppearanceLarge" 
		android:textColor="#7FD4FF" />
	</LinearLayout>
	<LinearLayout
	    android:orientation="horizontal"
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1">
	    <Button
		android:layout_width="1dp"
		android:layout_height="fill_parent"
		android:layout_weight="1"
		android:text="-0.1"
		android:textAppearance="?android:attr/textAppearanceMedium"
		android:onClick="A_decrp1" />
	    <Button
		android:layout_width="1dp"
		android:layout_height="fill_parent"
		android:layout_weight="1"
		android:text="-1"
		android:textAppearance="?android:attr/textAppearanceMedium"
		android:onClick="A_decr1" />
	</LinearLayout>
    </LinearLayout>
    <Button
	android:layout_width="1dp"
	android:layout_height="fill_parent"
	android:layout_weight="1"
	android:text="reset"
	android:textAppearance="?android:attr/textAppearanceMedium"
	android:textColor="#0058A0"
	android:onClick="reset_afreq" />
</LinearLayout>
