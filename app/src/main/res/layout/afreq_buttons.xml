<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">
    <LinearLayout
	android:layout_width="1dp"
	android:layout_height="fill_parent"
	android:layout_weight="2"
	android:orientation="vertical">
	<LinearLayout
	    android:orientation="horizontal"
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1">
	    <Button
		style="@style/Tuner.Button.Panel"
		android:layout_width="1dp"
		android:layout_height="fill_parent"
		android:layout_weight="1"
		android:text="+0.1"
		android:onClick="A_incrp1" />
	    <Button
		style="@style/Tuner.Button.Panel"
		android:layout_width="1dp"
		android:layout_height="fill_parent"
		android:layout_weight="1"
		android:text="+1"
		android:onClick="A_incr1" />
	</LinearLayout>
	<TextView android:id="@+id/center_display2"
	    style="@style/Tuner.Readout"
	    android:layout_width="fill_parent"
	    android:layout_height="wrap_content" />
	<LinearLayout
	    android:orientation="horizontal"
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1">
	    <Button
		style="@style/Tuner.Button.Panel"
		android:layout_width="1dp"
		android:layout_height="fill_parent"
		android:layout_weight="1"
		android:text="-0.1"
		android:onClick="A_decrp1" />
	    <Button
		style="@style/Tuner.Button.Panel"
		android:layout_width="1dp"
		android:layout_height="fill_parent"
		android:layout_weight="1"
		android:text="-1"
		android:onClick="A_decr1" />
	</LinearLayout>
    </LinearLayout>
    <Button
	style="@style/Tuner.Button.Panel"
	android:layout_width="1dp"
	android:layout_height="fill_parent"
	android:layout_weight="1"
	android:text="reset"
	android:textColor="@color/warn"
	android:onClick="reset_afreq" />
</LinearLayout>
