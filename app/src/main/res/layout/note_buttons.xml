<?xml version="1.0" encoding="utf-8"?>
<!-- note mode.  the note with its octave ("C#4", German "cis&#185;") is
     one display, centred between the semitone and octave buttons -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">
    <LinearLayout
	android:layout_width="fill_parent"
	android:layout_height="1dp"
	android:layout_weight="1"
	android:orientation="horizontal">
	<Button android:id="@+id/semi_plus"
	    style="@style/Tuner.Button.Panel"
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="1"
	    android:text="@string/semi_plus"
	    android:longClickable="true"
	    android:onClick="semi_incr" />
	<Button
	    style="@style/Tuner.Button.Panel"
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="1"
	    android:text="@string/oct_plus"
	    android:onClick="oct_incr" />
	<Button
	    style="@style/Tuner.Button.Panel"
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="1"
	    android:text="@string/cent_plus"
	    android:onClick="cent_incr" />
    </LinearLayout>
    <LinearLayout
	android:layout_width="fill_parent"
	android:layout_height="wrap_content"
	android:orientation="horizontal">
	<TextView android:id="@+id/semi_display"
	    style="@style/Tuner.Readout"
	    android:layout_width="1dp"
	    android:layout_height="wrap_content"
	    android:layout_weight="2" />
	<TextView android:id="@+id/cent_display"
	    style="@style/Tuner.Readout"
	    android:layout_width="1dp"
	    android:layout_height="wrap_content"
	    android:layout_weight="1" />
    </LinearLayout>
    <LinearLayout
	android:layout_width="fill_parent"
	android:layout_height="1dp"
	android:layout_weight="1"
	android:orientation="horizontal">
	<Button android:id="@+id/semi_minus"
	    style="@style/Tuner.Button.Panel"
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="1"
	    android:text="@string/semi_minus"
	    android:longClickable="true"
	    android:onClick="semi_decr" />
	<Button
	    style="@style/Tuner.Button.Panel"
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="1"
	    android:text="@string/oct_minus"
	    android:onClick="oct_decr" />
	<Button
	    style="@style/Tuner.Button.Panel"
	    android:layout_width="1dp"
	    android:layout_height="fill_parent"
	    android:layout_weight="1"
	    android:text="@string/cent_minus"
	    android:onClick="cent_decr" />
    </LinearLayout>
</LinearLayout>
