<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true">
    <EditText android:id="@+id/preset_name"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content"
	android:layout_marginLeft="12dp"
	android:layout_marginRight="12dp"
	android:minHeight="56dp"
	android:textAppearance="?android:attr/textAppearanceLarge"
	android:hint="preset name"
	android:inputType="textCapSentences"
	android:lines="1"
	android:singleLine="true"
	android:imeOptions="actionDone" />
    <TextView android:id="@+id/list_empty"
	android:layout_width="fill_parent"
	android:layout_height="1dp"
	android:layout_weight="1"
	android:visibility="gone"
	android:gravity="center"
	android:padding="16dp"
	android:textAppearance="?android:attr/textAppearanceLarge"
	android:textColor="@color/text_muted"
	android:text="no notes" />
    <ListView android:id="@+id/note_list"
	android:layout_width="fill_parent"
	android:layout_height="1dp"
	android:layout_weight="1" />
    <LinearLayout
	android:orientation="horizontal"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content">
	<Button
	    style="@style/Tuner.Button.Big"
	    android:layout_width="1dp"
	    android:layout_height="wrap_content"
	    android:layout_weight="1"
	    android:minHeight="56dp"
	    android:text="delete preset"
	    android:textColor="@color/warn"
	    android:onClick="do_delete" />
	<Button
	    style="@style/Tuner.Button.Big"
	    android:layout_width="1dp"
	    android:layout_height="wrap_content"
	    android:layout_weight="1"
	    android:minHeight="56dp"
	    android:text="add note"
	    android:onClick="do_new" />
    </LinearLayout>
</LinearLayout>
