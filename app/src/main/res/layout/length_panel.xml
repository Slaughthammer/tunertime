<?xml version="1.0" encoding="utf-8"?>
<!-- length mode readout, added below the strobes in organ mode: the
     verdict across the full width, the details, then the pipe controls -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content">
    <TextView android:id="@+id/length_display"
	style="@style/Tuner.Readout"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content"
	android:maxLines="2"
	android:autoSizeMaxTextSize="26sp" />
    <TextView android:id="@+id/length_detail_display"
	style="@style/Tuner.Caption"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content"
	android:maxLines="2"
	android:fontFamily="monospace" />
    <include layout="@layout/length_controls" />
</LinearLayout>
