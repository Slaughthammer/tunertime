<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">
    <LinearLayout
	android:layout_width="1dp"
	android:layout_height="fill_parent"
	android:layout_weight="2"
	android:orientation="vertical">
	<Button
	    style="@style/Tuner.Button.Panel"
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:text="stretch+"
	    android:onClick="stretch_incr" />
	<TextView android:id="@+id/stretch_display2"
	    style="@style/Tuner.Readout"
	    android:layout_width="fill_parent"
	    android:layout_height="wrap_content" />
	<TextView
	    style="@style/Tuner.Caption"
	    android:layout_width="fill_parent"
	    android:layout_height="wrap_content"
	    android:text="cents/octave" />
	<Button
	    style="@style/Tuner.Button.Panel"
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:text="stretch-"
	    android:onClick="stretch_decr" />
    </LinearLayout>
    <Button
	style="@style/Tuner.Button.Panel"
	android:layout_width="1dp"
	android:layout_height="fill_parent"
	android:layout_weight="1"
	android:text="reset"
	android:textColor="@color/warn"
	android:onClick="reset_stretch" />
</LinearLayout>
