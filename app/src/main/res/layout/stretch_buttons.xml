<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">
    <LinearLayout
	android:layout_width="1dp"
	android:layout_height="fill_parent"
	android:layout_weight="2"
	android:orientation="vertical">
	<Button
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:text="stretch+"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="stretch_incr" />
	<TextView android:id="@+id/stretch_display2"
	    android:layout_width="fill_parent"
	    android:layout_height="wrap_content"
	    android:gravity="center"
	    android:lines="1"
	    android:singleLine="true"
	    android:textAppearance="?android:attr/textAppearanceLarge"
	    android:textColor="#FF8C00" />
	<TextView
	    android:layout_width="fill_parent"
	    android:layout_height="wrap_content"
	    android:gravity="center"
	    android:text="cents/octave"
	    android:lines="1"
	    android:singleLine="true"
	    android:textAppearance="?android:attr/textAppearanceSmall"
	    android:textColor="#FFD47F" />
	<Button
	    android:layout_width="fill_parent"
	    android:layout_height="1dp"
	    android:layout_weight="1"
	    android:text="stretch-"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="stretch_decr" />
    </LinearLayout>
    <Button
	android:layout_width="1dp"
	android:layout_height="fill_parent"
	android:layout_weight="1"
	android:text="reset"
	android:textAppearance="?android:attr/textAppearanceMedium"
	android:textColor="#A05800"
	android:onClick="reset_stretch" />
</LinearLayout>
