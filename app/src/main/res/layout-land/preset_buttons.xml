<?xml version="1.0" encoding="utf-8"?>
<!-- preset mode.  the preset note with octave and offset is one display,
     centred between the note and octave buttons -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_height="fill_parent"
    android:layout_width="fill_parent">
    <LinearLayout
	android:layout_height="1dp"
	android:layout_width="fill_parent"
	android:layout_weight="2"
	android:orientation="horizontal">
	<LinearLayout
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:orientation="vertical">
	    <Button
		style="@style/Tuner.Button.Panel"
		android:layout_height="1dp"
		android:layout_width="fill_parent"
		android:layout_weight="1"
		android:text="@string/note_minus"
		android:onClick="preset_decr" />
	    <Button
		style="@style/Tuner.Button.Panel"
		android:layout_height="1dp"
		android:layout_width="fill_parent"
		android:layout_weight="1"
		android:text="@string/oct_minus"
		android:onClick="preset_oct_decr" />
	</LinearLayout>
	<TextView android:id="@+id/preset_semi_display"
	    style="@style/Tuner.Readout"
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:maxLines="2" />
	<LinearLayout
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:orientation="vertical">
	    <Button
		style="@style/Tuner.Button.Panel"
		android:layout_height="1dp"
		android:layout_width="fill_parent"
		android:layout_weight="1"
		android:text="@string/note_plus"
		android:onClick="preset_incr" />
	    <Button
		style="@style/Tuner.Button.Panel"
		android:layout_height="1dp"
		android:layout_width="fill_parent"
		android:layout_weight="1"
		android:text="@string/oct_plus"
		android:onClick="preset_oct_incr" />
	</LinearLayout>
    </LinearLayout>
    <LinearLayout
	android:layout_height="1dp"
	android:layout_width="fill_parent"
	android:layout_weight="1"
	android:orientation="horizontal">
	<Button android:id="@+id/preset_select"
	    style="@style/Tuner.Button.Panel"
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:text="@string/select"
	    android:onClick="do_preset_select" />
	<Button android:id="@+id/preset_edit"
	    style="@style/Tuner.Button.Panel"
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:text="@string/edit"
	    android:onClick="do_preset_edit" />
    </LinearLayout>
</LinearLayout>
