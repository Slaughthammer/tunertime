<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_height="fill_parent"
    android:layout_width="fill_parent">
    <TextView
	android:layout_height="wrap_content"
	android:layout_width="fill_parent"
	android:gravity="center"
	android:lines="1"
	android:singleLine="true"
	android:textAppearance="?android:attr/textAppearanceMedium"
	android:text="note" />
    <LinearLayout
	android:layout_height="1dp"
	android:layout_width="fill_parent"
	android:layout_weight="1"
	android:orientation="horizontal">
	<Button
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:text="-"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="preset_decr" />
	<TextView android:id="@+id/preset_semi_display"
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:gravity="center"
	    android:lines="2"
	    android:singleLine="false"
	    android:textAppearance="?android:attr/textAppearanceMedium" 
	    android:textColor="#29A3FF" />
	<Button
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:text="+"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="preset_incr" />
    </LinearLayout>
    <TextView
	android:layout_height="wrap_content"
	android:layout_width="fill_parent"
	android:gravity="center"
	android:lines="1"
	android:singleLine="true"
	android:textAppearance="?android:attr/textAppearanceMedium"
	android:text="oct" />
    <LinearLayout
	android:layout_height="1dp"
	android:layout_width="fill_parent"
	android:layout_weight="1"
	android:orientation="horizontal">
	<Button
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:text="-"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="preset_oct_decr" />
	<TextView android:id="@+id/preset_oct_display"
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:gravity="center"
	    android:lines="1"
	    android:singleLine="true"
	    android:textAppearance="?android:attr/textAppearanceLarge" 
	    android:textColor="#29A3FF" />
	<Button
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:text="+"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="preset_oct_incr" />
    </LinearLayout>
    <LinearLayout
	android:layout_height="1dp"
	android:layout_width="fill_parent"
	android:layout_weight="1"
	android:orientation="horizontal">
	<Button android:id="@+id/preset_select"
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:text="select"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="do_preset_select" />
	<Button android:id="@+id/preset_edit"
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:text="edit"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="do_preset_edit" />
    </LinearLayout>
</LinearLayout>
