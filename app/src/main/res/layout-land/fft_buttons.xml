<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">
    <TextView
	style="@style/Tuner.Caption"
	android:layout_height="wrap_content"
	android:layout_width="fill_parent"
	android:text="N" />
    <LinearLayout
	android:layout_height="1dp"
	android:layout_width="fill_parent"
	android:layout_weight="1"
	android:orientation="horizontal">
	<Button
	    style="@style/Tuner.Button.Panel"
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:text="-"
	    android:onClick="N_decr" />
	<TextView android:id="@+id/N_display"
	    style="@style/Tuner.Readout"
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="2" />
	<Button
	    style="@style/Tuner.Button.Panel"
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:text="+"
	    android:onClick="N_incr" />
    </LinearLayout>
    <Button android:id="@+id/grid_button"
	style="@style/Tuner.Button.Panel"
	android:layout_width="fill_parent"
	android:layout_height="1dp"
	android:layout_weight="1"
	android:text="scale"
	android:onClick="grid_toggle" />
</LinearLayout>
