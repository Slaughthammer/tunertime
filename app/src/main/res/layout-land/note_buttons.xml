<?xml version="1.0" encoding="utf-8"?>
<!-- note mode.  the note with its octave is one display, centred between
     the semitone and octave buttons -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_height="fill_parent"
    android:layout_width="fill_parent">
    <LinearLayout
	android:layout_height="1dp"
	android:layout_width="fill_parent"
	android:layout_weight="2"
	android:orientation="horizontal">
	<LinearLayout
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:orientation="vertical">
	    <Button android:id="@+id/semi_minus"
		style="@style/Tuner.Button.Panel"
		android:layout_height="1dp"
		android:layout_width="fill_parent"
		android:layout_weight="1"
		android:text="semi-"
		android:longClickable="true"
		android:onClick="semi_decr" />
	    <Button
		style="@style/Tuner.Button.Panel"
		android:layout_height="1dp"
		android:layout_width="fill_parent"
		android:layout_weight="1"
		android:text="oct-"
		android:onClick="oct_decr" />
	</LinearLayout>
	<TextView android:id="@+id/semi_display"
	    style="@style/Tuner.Readout"
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1" />
	<LinearLayout
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:orientation="vertical">
	    <Button android:id="@+id/semi_plus"
		style="@style/Tuner.Button.Panel"
		android:layout_height="1dp"
		android:layout_width="fill_parent"
		android:layout_weight="1"
		android:text="semi+"
		android:longClickable="true"
		android:onClick="semi_incr" />
	    <Button
		style="@style/Tuner.Button.Panel"
		android:layout_height="1dp"
		android:layout_width="fill_parent"
		android:layout_weight="1"
		android:text="oct+"
		android:onClick="oct_incr" />
	</LinearLayout>
    </LinearLayout>
    <TextView
	style="@style/Tuner.Caption"
	android:layout_height="wrap_content"
	android:layout_width="fill_parent"
	android:text="cent" />
    <LinearLayout
	android:layout_height="1dp"
	android:layout_width="fill_parent"
	android:layout_weight="1"
	android:orientation="horizontal">
	<Button
	    style="@style/Tuner.Button.Panel"
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:text="-"
	    android:onClick="cent_decr" />
	<TextView android:id="@+id/cent_display"
	    style="@style/Tuner.Readout"
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1" />
	<Button
	    style="@style/Tuner.Button.Panel"
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:text="+"
	    android:onClick="cent_incr" />
    </LinearLayout>
</LinearLayout>
