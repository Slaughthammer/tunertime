<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_height="fill_parent"
    android:layout_width="fill_parent">
    <TextView
	android:layout_height="wrap_content"
	android:layout_width="fill_parent"
	android:gravity="center"
	android:lines="1"
	android:singleLine="true"
	android:textAppearance="?android:attr/textAppearanceMedium"
	android:text="semi" />
    <LinearLayout
	android:layout_height="1dp"
	android:layout_width="fill_parent"
	android:layout_weight="1"
	android:orientation="horizontal">
	<Button android:id="@+id/semi_minus"
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:text="-"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:longClickable="true"
	    android:onClick="semi_decr" />
	<TextView android:id="@+id/semi_display"
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:gravity="center"
	    android:lines="1"
	    android:singleLine="true"
	    android:textAppearance="?android:attr/textAppearanceLarge" 
	    android:textColor="#FFA329" />
	<Button android:id="@+id/semi_plus"
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:text="+"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:longClickable="true"
	    android:onClick="semi_incr" />
    </LinearLayout>
    <TextView
	android:layout_height="wrap_content"
	android:layout_width="fill_parent"
	android:gravity="center"
	android:lines="1"
	android:singleLine="true"
	android:textAppearance="?android:attr/textAppearanceMedium"
	android:text="oct" />
    <LinearLayout
	android:layout_height="1dp"
	android:layout_width="fill_parent"
	android:layout_weight="1"
	android:orientation="horizontal">
	<Button
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:text="-"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="oct_decr" />
	<TextView android:id="@+id/oct_display"
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:gravity="center"
	    android:lines="1"
	    android:singleLine="true"
	    android:textAppearance="?android:attr/textAppearanceLarge" 
	    android:textColor="#FFA329" />
	<Button
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:text="+"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="oct_incr" />
    </LinearLayout>
    <TextView
	android:layout_height="wrap_content"
	android:layout_width="fill_parent"
	android:gravity="center"
	android:lines="1"
	android:singleLine="true"
	android:textAppearance="?android:attr/textAppearanceMedium"
	android:text="cent" />
    <LinearLayout
	android:layout_height="1dp"
	android:layout_width="fill_parent"
	android:layout_weight="1"
	android:orientation="horizontal">
	<Button
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:text="-"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="cent_decr" />
	<TextView android:id="@+id/cent_display"
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:gravity="center"
	    android:lines="1"
	    android:singleLine="true"
	    android:textAppearance="?android:attr/textAppearanceLarge" 
	    android:textColor="#FFA329" />
	<Button
	    android:layout_height="fill_parent"
	    android:layout_width="1dp"
	    android:layout_weight="1"
	    android:text="+"
	    android:textAppearance="?android:attr/textAppearanceMedium"
	    android:onClick="cent_incr" />
    </LinearLayout>
</LinearLayout>
