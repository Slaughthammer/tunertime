<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="Strobe">
	<ListPreference
		android:key="strobe_color"
		android:title="Colors"
		android:summary="%s"
		android:entries="@array/color_name"
		android:entryValues="@array/color_value"
		android:defaultValue="slate" />
	<MultiSelectListPreference
		android:key="harmonics"
		android:title="Harmonics shown"
		android:summary="One strobe row per checked harmonic, lowest first (up to 8)"
		android:entries="@array/harmonics"
		android:entryValues="@array/harmonics"
		android:defaultValue="@array/harmonics_default" />
    </PreferenceCategory>
</PreferenceScreen>
