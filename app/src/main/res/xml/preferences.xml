<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="Strobe">
	<ListPreference
		android:key="strobe_color"
		android:title="Colors"
		android:summary="%s"
		android:entries="@array/color_name"
		android:entryValues="@array/color_value"
		android:defaultValue="slate" />
	<ListPreference
		android:key="harm0"
		android:title="Harmonic 0"
		android:summary="%s"
		android:entries="@array/harmonics"
		android:entryValues="@array/harmonics"
		android:defaultValue="1" />
	<ListPreference
		android:key="harm1"
		android:title="Harmonic 1"
		android:summary="%s"
		android:entries="@array/harmonics"
		android:entryValues="@array/harmonics"
		android:defaultValue="2" />
	<ListPreference
		android:key="harm2"
		android:title="Harmonic 2"
		android:summary="%s"
		android:entries="@array/harmonics"
		android:entryValues="@array/harmonics"
		android:defaultValue="4" />
    </PreferenceCategory>
</PreferenceScreen>
