<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="Main">
	<CheckBoxPreference
		android:key="organ_mode"
		android:title="Organ mode"
		android:summary="Tuning organ pipes: no stretch, organ-specific displays"
		android:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Audio">
	<ListPreference
		android:key="audio_source"
		android:title="Audio source"
		android:summary="%s"
		android:entries="@array/audio_source_name"
		android:entryValues="@array/audio_source_value"
		android:defaultValue="auto" />
	<ListPreference
		android:key="microphone"
		android:title="Microphone"
		android:summary="%s"
		android:entries="@array/microphone_name"
		android:entryValues="@array/microphone_value"
		android:defaultValue="auto" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Strobe">
	<ListPreference
		android:key="strobe_color"
		android:title="Colors"
		android:summary="%s"
		android:entries="@array/color_name"
		android:entryValues="@array/color_value"
		android:defaultValue="batlow" />
	<MultiSelectListPreference
		android:key="harmonics"
		android:title="Harmonics shown"
		android:summary="One strobe row per checked harmonic, lowest first (up to 8)"
		android:entries="@array/harmonics"
		android:entryValues="@array/harmonics"
		android:defaultValue="@array/harmonics_default" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Presets">
	<CheckBoxPreference
		android:key="note_temper"
		android:title="12-note preset tempers note mode"
		android:summary="If the selected preset has one note for each of the 12 semitones, note mode tunes to its offsets"
		android:defaultValue="true" />
    </PreferenceCategory>
</PreferenceScreen>
