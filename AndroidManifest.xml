<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
      package="org.galexander.tunertime"
      android:versionCode="15"
      android:versionName="15">
    <uses-sdk android:minSdkVersion="7" android:targetSdkVersion="13" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application android:label="TunerTime" android:icon="@drawable/icon">
        <activity android:name="TunerTime" android:label="TunerTime">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="Settings" android:label="Settings" />
	<activity android:name="PresetSelectActivity"
		android:label="Select preset" />
	<activity android:name="PresetEditActivity"
		android:label="Edit preset" />
	<activity android:name="PresetNoteActivity"
		android:label="Edit preset note" />
    </application>
</manifest> 
